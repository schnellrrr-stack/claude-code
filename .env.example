# Apollo.io API Configuration
APOLLO_API_KEY=your_apollo_api_key_here

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Search Parameters (optional - can be overridden in code)
DEFAULT_PERSON_TITLES=CEO,CTO,VP Engineering,Head of Engineering
DEFAULT_COMPANY_SIZE=1-10,11-50,51-200
DEFAULT_INDUSTRY=Computer Software,Information Technology

# Output Settings
OUTPUT_FORMAT=json
MAX_RESULTS=100
